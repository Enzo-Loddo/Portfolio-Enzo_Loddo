---
import DiscoverMobile from '@/components/about/DiscoverMobile.astro';
import DiscoverStage from '@/components/about/DiscoverStage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Me découvrir — Enzo Loddo"
  description="Originaire de La Réunion, étudiant en BUT MMI à Montbéliard : mon parcours, mes outils et mon univers."
  header="none"
  footer={false}
  background="bg-stage"
>
  <!-- Desktop : scène animée (fixe + arrière-plan qui défile). Mobile : version en une colonne. -->
  <div class="hidden md:block">
    <DiscoverStage />
  </div>
  <div class="md:hidden">
    <DiscoverMobile />
  </div>
</BaseLayout>
