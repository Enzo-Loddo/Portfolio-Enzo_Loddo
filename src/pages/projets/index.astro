---
import ProjectShowcase from '@/components/projects/ProjectShowcase.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/projects';

const projects = await getProjects();
---

<BaseLayout
  title="Mes projets — Enzo Loddo"
  description="Affiches, posts et stories pour les réseaux sociaux : toutes mes créations en design et direction artistique."
>
  <div class="mx-auto w-full max-w-7xl px-4 pb-20 pt-4 md:px-8 md:pb-28">
    <h1 class="text-[2.75rem] leading-[1.1] uppercase text-accent md:text-h1">MES PROJETS</h1>
    <p class="mb-8 mt-4 max-w-2xl text-body-m text-fg md:text-body-l">
      Retrouve ici toutes mes créations en tout genre : affiches, posts et stories pour les réseaux sociaux.
    </p>
    <ProjectShowcase projects={projects} />
  </div>
</BaseLayout>
