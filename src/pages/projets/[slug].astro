---
/**
 * Présentation d'un projet « simple » (/projets/<slug>) : tous ceux qui n'ont pas leur propre page grand format
 * (une page grand format = un fichier src/pages/projets/<slug>.astro, ex. compton.astro).
 */
import ProjectSimple from '@/components/projet/ProjectSimple.astro';
import { getPublishedProjects } from '@/lib/projects';
import { hasFullPage } from '@/lib/project-links';
import type { Project } from '@/types/project';

export async function getStaticPaths() {
  const all = await getPublishedProjects();
  return all
    .filter((p) => !hasFullPage(p.slug))
    .map((project) => {
      const i = all.findIndex((p) => p.slug === project.slug);
      return { params: { slug: project.slug }, props: { project, prev: all[i - 1], next: all[i + 1] } };
    });
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;
---

<ProjectSimple project={project} prev={prev} next={next} />
