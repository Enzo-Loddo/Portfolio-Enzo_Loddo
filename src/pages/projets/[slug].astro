---
/**
 * Page détaillée d'un projet « simple » : galerie de visuels, description et outils utilisés.
 * Elle sert tous les projets qui n'ont pas leur propre page grand format
 * (une page dédiée = un fichier src/pages/projets/<slug>.astro, ex. compton.astro).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tools } from '@/data/discover';
import { getPublishedProjects } from '@/lib/projects';
import type { Project } from '@/types/project';

export async function getStaticPaths() {
  const dedicated = Object.keys(import.meta.glob('./*.astro')).map((f) => f.replace(/^\.\/|\.astro$/g, ''));
  const projects = (await getPublishedProjects()).filter((p) => !dedicated.includes(p.slug));
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const images = project.galerie?.length ? project.galerie : project.visuel ? [{ src: project.visuel, alt: project.visuelAlt ?? project.titre }] : [];
const toolFor = (name: string) => tools.find((t) => t.name.toLowerCase().startsWith(name.toLowerCase()));
---

<BaseLayout
  title={`${project.titre} — Enzo Loddo`}
  description={project.description[0]?.slice(0, 155)}
>
  <article class="mx-auto w-full max-w-7xl px-4 pb-20 pt-4 md:px-8 md:pb-28">
    <a href="/projets" class="inline-block py-2 font-display text-nav uppercase text-fg-2 hover:text-accent">← Retour aux projets</a>

    <header class="mt-4 flex flex-col gap-4">
      <h1 class="text-[2.75rem] leading-[1.05] uppercase text-accent md:text-h1">{project.titre}</h1>
      <ul class="flex flex-wrap gap-2" aria-label="Informations du projet">
        <li class="border-2 border-accent px-3 py-1 font-display text-label uppercase tracking-widest text-accent">{project.itemId}</li>
        <li class="border-2 border-accent px-3 py-1 font-display text-label uppercase tracking-widest text-accent">{project.sujet}</li>
        <li class="border-2 border-accent px-3 py-1 font-display text-label uppercase tracking-widest text-accent">{project.categorie}</li>
      </ul>
    </header>

    <div class="mt-10 grid gap-10 md:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] md:gap-16" data-gallery>
      <div>
        {images.length > 0 && <img data-main src={images[0].src} alt={images[0].alt} class="w-full bg-black" fetchpriority="high" />}
        {
          images.length > 1 && (
            <ul class="mt-3 flex flex-wrap gap-3" aria-label="Visuels du projet">
              {images.map((im, k) => (
                <li>
                  <button
                    type="button"
                    data-thumb
                    data-src={im.src}
                    data-alt={im.alt}
                    aria-pressed={k === 0 ? 'true' : 'false'}
                    aria-label={`Visuel ${k + 1} sur ${images.length}`}
                    class="block w-20 border-2 border-line bg-black aria-pressed:border-accent hover:border-fg"
                  >
                    <img src={im.src} alt="" loading="lazy" class="aspect-4/5 w-full object-cover" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="flex flex-col gap-10">
        <section aria-labelledby="desc-title" class="flex flex-col gap-4">
          <h2 id="desc-title" class="text-3xl uppercase text-accent md:text-h3">Description</h2>
          {project.description.map((p) => <p class="text-body-m text-accent md:text-body-l">{p}</p>)}
        </section>

        {
          project.outils.length > 0 && (
            <section aria-labelledby="tools-title" class="flex flex-col gap-4">
              <h2 id="tools-title" class="text-3xl uppercase text-accent md:text-h3">Outils utilisés</h2>
              <ul class="flex flex-wrap gap-5">
                {project.outils.map((name) => {
                  const t = toolFor(name);
                  return (
                    <li class="flex items-center gap-3">
                      {t ? (
                        <span class="relative block size-16 shrink-0 rounded-[19%] bg-accent">
                          <img
                            src={t.src}
                            alt=""
                            class="absolute"
                            style={`left:${(t.logo.x / 123) * 100}%;top:${(t.logo.y / 123) * 100}%;width:${(t.logo.w / 123) * 100}%;height:${(t.logo.h / 123) * 100}%`}
                          />
                        </span>
                      ) : (
                        <span class="grid size-16 shrink-0 place-items-center rounded-[19%] bg-accent font-display text-2xl text-ink">{name.slice(0, 2)}</span>
                      )}
                      <span class="font-display text-nav uppercase text-fg">{name}</span>
                    </li>
                  );
                })}
              </ul>
            </section>
          )
        }

        <a
          href="/projets"
          class="inline-flex w-fit items-center gap-3 rounded-full bg-accent px-8 py-3.5 font-display text-nav font-semibold uppercase tracking-wide text-ink hover:bg-fg"
        >
          Tous mes projets <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const main = root.querySelector<HTMLImageElement>('[data-main]');
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', () => {
        if (!main) return;
        main.src = thumb.dataset.src!;
        main.alt = thumb.dataset.alt!;
        thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
      }),
    );
  });
</script>
