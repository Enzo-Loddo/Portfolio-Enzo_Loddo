---
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Enzo Loddo"
  description="Contacte Enzo Loddo sur ses réseaux ou par e-mail pour un stage, une alternance ou un projet."
>
  <div class="flex flex-col gap-12 px-4 pb-16 pt-6 md:flex-row md:items-center md:justify-between md:gap-16 md:px-8 md:pb-24 md:pt-12">
    <div class="flex max-w-3xl flex-col gap-6">
      <h1 class="text-[2.75rem] leading-[1.1] uppercase text-accent md:text-h1">
        ALLON MET LA MAIN <br />ENSAMB<span aria-hidden="true">*</span>
      </h1>
      <p class="max-w-xl text-body-m text-fg md:text-body-l">
        Contacte-moi sur mes différents réseaux, on pourrait bien s’entendre.
      </p>
      <SocialLinks variant="boxed" />
      <a href={`mailto:${site.email}`} class="font-display text-3xl text-accent md:text-h3">{site.email}</a>
      <p class="text-caption text-fg-muted">* « Allons mettre la main ensemble », en créole réunionnais.</p>
    </div>
    <!-- Photo : cadre blanc incliné et scotch, comme les visuels des pages projet -->
    <figure class="relative mx-auto w-full max-w-sm shrink-0 rotate-2 md:mx-0 md:max-w-md">
      <span
        class="absolute left-1/2 top-[-1.1rem] z-10 h-10 w-28 -translate-x-1/2 -rotate-3 bg-contain bg-center bg-no-repeat"
        style="background-image: url('/images/projets/commun/scotch.webp')"
        aria-hidden="true"
      ></span>
      <div class="bg-white p-2.5 shadow-[0_1rem_2rem_rgb(0_0_0/0.45)] md:p-3">
        <img
          src="/images/contact/enzo-reunion.webp"
          alt="Enzo marchant sur des rochers volcaniques au bord de l’océan, à La Réunion, le téléphone à l’oreille"
          width="1000"
          height="1333"
          class="block h-auto w-full"
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>
</BaseLayout>
