---
import '@fontsource-variable/oswald';
import '@fontsource-variable/inter';
import '@/styles/global.css';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** `home` affiche le bandeau DEPARTURES, `inner` le bandeau ARRIVALS. */
  header?: 'home' | 'inner';
}
const { title = site.title, description = site.description, header = 'inner' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2c2c2c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col bg-base">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-ink"
    >
      Aller au contenu
    </a>
    <Header variant={header} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
