---
/**
 * Modèle de page projet : la couverture reste fixe, puis le contenu monte et la recouvre au défilement.
 * Même disposition pour tous les projets ; seul le contenu (src/data/project-pages.ts) change.
 */
import { richSegments, type ProjectPageContent } from '@/data/project-pages';
import BeforeAfter from './BeforeAfter.astro';

interface Props {
  page: ProjectPageContent;
  title: string;
}
const { page, title } = Astro.props;
const { cover, meta, intro, research, film, compare, next } = page;
---

<!-- Couverture fixe -->
<section class="cover" aria-label="Couverture">
  <img src={cover.src} alt="" class="cover-backdrop" aria-hidden="true" />
  <picture>
    {cover.srcMobile && <source media="(max-width: 767px)" srcset={cover.srcMobile} />}
    <img src={cover.src} alt={cover.alt} class="cover-img" fetchpriority="high" />
  </picture>
  {
    cover.liveText && (
      <div class="cover-text">
        <p>{cover.liveText.eyebrow}</p>
        <p class="cover-title">{cover.liveText.title}</p>
        <p>{cover.liveText.place}</p>
      </div>
    )
  }
  <p class="cover-hint" aria-hidden="true">Défiler <span>↓</span></p>
</section>
<div class="cover-spacer" aria-hidden="true"></div>

<!-- Feuille qui recouvre la couverture -->
<article class="sheet">
  <header class="wrap head" data-reveal>
    <a href="/projets" class="back">← Retour aux projets</a>
    <h1 class="title">{title}</h1>
    <p class="meta">
      <span>{meta.item}</span><span>{meta.sujet}</span><span>{meta.outils.join(' · ')}</span>
    </p>
  </header>

  <!-- 1. Synopsis + citation -->
  <section class="wrap intro" aria-labelledby="intro-title">
    <div class="intro-main" data-reveal>
      <h2 id="intro-title" class="kicker">{intro.kicker}</h2>
      <p class="lead">{richSegments(intro.synopsis).map((s) => (s.b ? <strong>{s.t}</strong> : s.i ? <em>{s.t}</em> : s.t))}</p>
    </div>
    {
      intro.quote && (
        <blockquote class="quote" data-reveal>
          <p>« {intro.quote.text} »</p>
          <footer>— {intro.quote.author}</footer>
        </blockquote>
      )
    }
  </section>

  <!-- 2. Note + recherches -->
  <section class="wrap research" aria-labelledby="research-title">
    <div class="research-text" data-reveal>
      <p class="note">{richSegments(intro.note).map((s) => (s.b ? <strong>{s.t}</strong> : s.t))}</p>
      <h2 id="research-title" class="h2">{research.title}</h2>
      {research.paragraphs.map((p) => <p class="body">{richSegments(p).map((s) => (s.b ? <strong>{s.t}</strong> : s.t))}</p>)}
    </div>
    <figure class="polaroid" data-reveal>
      <img src={research.image.src} alt={research.image.alt} loading="lazy" />
      <span class="tape" aria-hidden="true"></span>
      {research.sticker && <img src={research.sticker.src} alt="" class="sticker" loading="lazy" />}
      <figcaption>{research.image.label}</figcaption>
    </figure>
  </section>

  <!-- 3. Vidéo -->
  {
    film && (
      <section class="wrap film" aria-labelledby="film-title">
        <h2 id="film-title" class="h2" data-reveal>{film.title}</h2>
        <div class="film-frame" data-reveal>
          <video
            controls
            preload="none"
            playsinline
            poster={film.poster}
            src={film.src}
            aria-label={`${film.title} — bande-annonce`}
          />
          <img src="/images/projets/la-cite-de-dieu/cadre-video.webp" alt="" class="film-border" aria-hidden="true" />
        </div>
        <p class="credit">{film.credit}</p>
      </section>
    )
  }

  <!-- 4. Avant / après -->
  {
    compare && (
      <section class="wrap compare" aria-labelledby="compare-title">
        <div class="compare-text" data-reveal>
          <h2 id="compare-title" class="h2">{compare.title}</h2>
          {compare.paragraphs.map((p) => <p class="body">{richSegments(p).map((s) => (s.b ? <strong>{s.t}</strong> : s.t))}</p>)}
        </div>
        <div class="compare-tool" data-reveal>
          <BeforeAfter before={compare.before} after={compare.after} />
          <p class="hint">Glisse la poignée pour comparer</p>
        </div>
      </section>
    )
  }

  <nav class="wrap next" aria-label="Suite" data-reveal>
    <a href={next.slug === 'projets' ? '/projets' : `/projets/${next.slug}`}>{next.label} →</a>
  </nav>
</article>

<style>
  /* --- Couverture fixe -------------------------------------------------- */
  .cover {
    position: fixed;
    inset: 0;
    z-index: 0;
    height: 100svh;
    overflow: hidden;
    background: #0b0b0b;
  }
  /* Bureau : l'image remplit l'écran. Elle est cadrée vers le bas pour garder tout le texte
     (« Welcome in Brazil … Cidade de Deus ») visible ; c'est le haut (ciel) qui est rogné. */
  .cover-backdrop { display: none; }
  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 88%;
  }
  /* Mobile (écran en hauteur) : image entière, le reste est comblé par une version floue de la photo */
  @media (max-width: 767px) {
    .cover-backdrop {
      display: block;
      position: absolute;
      inset: -5%;
      width: 110%;
      height: 110%;
      object-fit: cover;
      filter: blur(28px) brightness(0.45);
    }
    .cover-img { position: relative; object-fit: contain; object-position: center; }
  }
  .cover-shade {
    position: absolute;
    inset: auto 0 0;
    height: 14%;
    background: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent);
  }
  .cover-text {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    color: #f6dd0b;
    font-family: var(--font-display);
    text-transform: uppercase;
  }
  .cover-title { font-size: clamp(5rem, 16vw, 14rem); font-weight: 700; line-height: 1; }
  .cover-hint {
    position: absolute;
    left: 50%;
    bottom: 0.6rem;
    translate: -50% 0;
    text-shadow: 0 1px 6px #000;
    font: 500 1rem/1 var(--font-display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
  }
  .cover-hint span { display: inline-block; animation: nudge 1.6s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateY(0.35rem); } }
  .cover-spacer { height: 100svh; }

  /* En-tête posé sur la couverture ; pied de page opaque pour masquer la couverture fixe */
  :global(body > header) { position: absolute; inset: 0 0 auto; z-index: 5; }
  :global(body > footer) { position: relative; z-index: 1; background-color: #191b1c; }

  /* --- Feuille ---------------------------------------------------------- */
  .sheet {
    position: relative;
    z-index: 1;
    background: #191b1c;
    padding-bottom: 6rem;
    box-shadow: 0 -2rem 4rem rgb(0 0 0 / 0.55);
    overflow-x: clip;
  }
  .wrap { width: min(100% - 2rem, 76rem); margin-inline: auto; }

  .head { padding-top: 4rem; display: grid; gap: 0.75rem; }
  .back { width: fit-content; font: 500 1rem/1.4 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: #d6d6d6; }
  .back:hover { color: #f6dd0b; }
  .title { font: 700 clamp(3rem, 8vw, 6.5rem)/1 var(--font-display); text-transform: uppercase; color: #f6dd0b; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font: 500 1rem/1.4 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; color: #b3b3b3; }

  .kicker { font: 500 1.125rem/1.3 var(--font-display); letter-spacing: 0.25em; text-transform: uppercase; color: #fff; }
  .h2 { font: 700 clamp(2rem, 4vw, 3rem)/1.1 var(--font-display); text-transform: uppercase; color: #f6dd0b; }
  .body, .lead, .note { font-size: 1.125rem; line-height: 1.65; color: #f6dd0b; }
  .lead { font-size: clamp(1.25rem, 2vw, 1.6rem); }
  .note { font-size: 1.25rem; }
  strong { font-weight: 600; color: #fff; }

  /* --- Mise en page des sections (identique pour chaque projet) ---------- */
  .intro { display: grid; gap: 2rem; padding-top: 4rem; }
  .intro-main { display: grid; gap: 1rem; max-width: 52rem; }
  .quote {
    justify-self: end;
    max-width: 34rem;
    padding: 1.5rem 1.75rem;
    background: #0b0b0b;
    border-left: 4px solid #f6dd0b;
    transform: rotate(-1deg);
  }
  .quote p { font: 500 1.5rem/1.35 var(--font-display); color: #fff; }
  .quote footer { margin-top: 0.5rem; font-size: 1rem; color: #b3b3b3; }

  .research, .compare { display: grid; gap: 3rem; padding-top: 6rem; align-items: start; }
  .research-text, .compare-text { display: grid; gap: 1.25rem; }

  .polaroid { position: relative; justify-self: center; width: min(100%, 26rem); rotate: 2deg; }
  .polaroid > img:first-child { width: 100%; box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.55); }
  .polaroid figcaption { margin-top: 0.75rem; text-align: center; font: 500 1.125rem/1 var(--font-display); letter-spacing: 0.15em; text-transform: uppercase; color: #fff; }
  .tape { position: absolute; top: -1.25rem; left: 50%; width: 9rem; height: 3.2rem; translate: -50% 0; rotate: -4deg; background: url('/images/projets/la-cite-de-dieu/scotch.webp') center / contain no-repeat; }
  .sticker { position: absolute; right: -2.5rem; bottom: -2rem; width: 7rem; rotate: -8deg; filter: drop-shadow(0 0.75rem 1rem rgb(0 0 0 / 0.5)); }

  .film { display: grid; gap: 1.5rem; padding-top: 6rem; }
  .film-frame { position: relative; aspect-ratio: 1045 / 598; width: min(100%, 60rem); margin-inline: auto; }
  .film-frame video { position: absolute; left: 1.2%; top: 4.2%; width: 97%; height: 93.2%; object-fit: cover; background: #000; }
  .film-border { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .credit { text-align: center; font-size: 1rem; color: #b3b3b3; }

  .compare-tool { display: grid; gap: 0.75rem; }
  .hint { text-align: center; font-size: 1rem; color: #b3b3b3; }

  .next { padding-top: 6rem; }
  .next a { display: inline-block; font: 700 clamp(1.75rem, 4vw, 2.5rem)/1.1 var(--font-display); text-transform: uppercase; color: #f6dd0b; transition: translate 0.25s; }
  .next a:hover { translate: 0.5rem 0; }

  @media (min-width: 768px) {
    .research { grid-template-columns: 1.1fr 0.9fr; gap: 5rem; }
    .compare { grid-template-columns: 0.9fr 1.1fr; gap: 5rem; }
    .compare-tool { order: 2; }
  }

  /* --- Apparition au défilement ------------------------------------------ */
  :global(html.js) [data-reveal] { opacity: 0; translate: 0 2.5rem; transition: opacity 0.8s ease, translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  :global(html.js) [data-reveal].is-visible { opacity: 1; translate: 0 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-reveal] { opacity: 1; translate: none; transition: none; }
    .cover-hint span { animation: none; }
  }
</style>

<script>
  document.documentElement.classList.add('js');
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
  );
  items.forEach((el) => io.observe(el));
</script>
