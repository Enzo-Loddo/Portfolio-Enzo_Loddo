---
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { nav, site } from '@/data/site';
---

<!-- Pas de fond plein : un dégradé transparent → sombre évite toute démarcation avec la page. -->
<footer class="mt-auto bg-linear-to-b from-transparent via-deep/40 to-deep/70 px-4 pb-8 pt-10 md:px-8 md:pt-14">
  <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
    <SocialLinks />
    <nav aria-label="Navigation du pied de page">
      <ul class="flex flex-col gap-3 md:flex-row md:gap-10">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-block font-display text-nav uppercase text-accent transition-transform hover:-translate-y-0.5"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="mt-8 flex justify-center">
    <button
      type="button"
      data-to-top
      class="inline-flex items-center gap-3 rounded-full border-2 border-accent px-6 py-2.5 font-display text-nav uppercase text-accent transition-colors hover:bg-accent hover:text-ink focus-visible:bg-accent focus-visible:text-ink"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
      Haut de page
    </button>
  </div>
  <p class="mt-6 text-center text-body-m text-fg-2">© {site.year} {site.name}</p>
</footer>

<script>
  // Remonte en haut de la page
  document.querySelectorAll<HTMLElement>('[data-to-top]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  });
</script>
