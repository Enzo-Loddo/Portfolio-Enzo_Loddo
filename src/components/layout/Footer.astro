---
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { nav, site } from '@/data/site';
---

<footer class="mt-auto bg-deep px-4 pb-8 pt-10 md:px-8 md:pt-12">
  <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
    <SocialLinks />
    <nav aria-label="Navigation du pied de page">
      <ul class="flex flex-col gap-3 md:flex-row md:gap-10">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="font-display text-nav uppercase text-accent hover:underline-offset-4">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <p class="mt-8 text-center text-body-m text-fg-2">© {site.year} {site.name}</p>
</footer>
