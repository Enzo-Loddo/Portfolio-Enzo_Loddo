---
/**
 * Scène « Me découvrir » (desktop) — reprise de la maquette Figma, enrichie.
 *
 * Principe (inchangé) : des éléments FIXES (logo ARRIVALS, appareil Polaroïd, flèches) et un arrière-plan
 * qui défile derrière eux à chaque clic. Ajouts :
 *  - écran d'arrivée (héros) qui se lève comme un rideau ;
 *  - parallaxe à la souris, balancement des plantes, poussière dorée, grain et lueur ;
 *  - flash d'appareil photo, photo qui « se développe », avion qui traverse le ciel ;
 *  - textes qui se composent mot à mot / lettre à lettre, tuiles qui rebondissent ;
 *  - indicateur d'étapes à droite.
 */
import hintBottom from '@/assets/discover/hint-bottom.svg';
import hintTop from '@/assets/discover/hint-top.svg';
import ArrivalsLogo from '@/components/layout/ArrivalsLogo.astro';
import DiscoverHero from './DiscoverHero.astro';
import { nav, site } from '@/data/site';
import {
  arrows, camera, cvHref, dust, header, hint, layers, SCENE, steps, strip, texts, toWords, tools, toolsPanel,
} from '@/data/discover';

type Pos = [number, number];
const posVars = (pos: Pos[]) => pos.map(([x, y], i) => `--x${i + 1}:${x};--y${i + 1}:${y}`).join(';');
const num = (n: number) => Math.round(n * 100) / 100;
let wi = 0;
---

<section class="discover" data-discover data-state="0" aria-label="Me découvrir">
  <div class="scene" data-scene>
    {/* Lueur chaude qui dérive lentement */}
    <div class="leak" aria-hidden="true"></div>

    {/* ---------- Arrière-plan mobile (défile à chaque état) ---------- */}
    {
      layers.map((l) => (
        <img
          class:list={['layer', 'decor', `a-${l.anchor}`]}
          src={l.src}
          alt={l.alt}
          width={Math.round(l.w)}
          height={Math.round(l.h)}
          style={[
            `--w:${num(l.w)}`,
            `--h:${num(l.h)}`,
            posVars(l.pos),
            `--depth:${l.depth}`,
            `--d:${l.enter}s`,
            l.sway ? `--sway:${l.sway.deg}deg;--sway-dur:${l.sway.dur}s;--sway-o:${l.sway.origin};--sway-delay:${l.sway.delay ?? 0}s` : '',
          ].join(';')}
          data-sway={l.sway ? '' : undefined}
          data-label={l.label}
          decoding="async"
          draggable="false"
        />
      ))
    }

    {/* Poussière dorée */}
    <div class="dust" aria-hidden="true">
      {
        dust.map((d) => (
          <span
            style={`left:${d.x}%;top:${d.y}%;width:${d.size}px;height:${d.size}px;--dur:${d.dur}s;--delay:${d.delay}s;--drift:${d.drift}px`}
          />
        ))
      }
    </div>

    {/* Bande de 4 Polaroïds qui sort de l'appareil */}
    <div
      class="layer a-l strip"
      style={`--w:${strip.w};--h:${strip.h};${posVars(strip.pos)};--depth:0;--d:1s`}
      aria-hidden="true"
    >
      <div
        class="abs bg-white"
        style={`--bx:${strip.backing.x};--by:${strip.backing.y};--bw:${strip.backing.w};--bh:${strip.backing.h}`}
      >
      </div>
      {
        strip.frames.map((f, i) => (
          <>
            <img
              class="abs"
              src={strip.frame.src}
              alt=""
              style={`--bx:0;--by:${f.y};--bw:${strip.frame.w};--bh:${strip.frame.h}`}
              decoding="async"
            />
            <img
              class={`abs photo p${i + 1}`}
              src={f.photo.src}
              alt={f.photo.alt}
              style={`--bx:${f.photo.x};--by:${f.photo.y};--bw:${f.photo.w};--bh:${f.photo.h}`}
              decoding="async"
            />
          </>
        ))
      }
    </div>

    {/* ---------- État 1 : titre, bio, indication « Clique » ---------- */}
    <h2 class="fx s1 title a-l" style="--x:30;--y:148" aria-label={texts.title}>
      {Array.from(texts.title).map((c, i) => <span class="chr" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
    </h2>
    <div class="fx s1 bio a-c" style="--x:445;--y:200;--w:640">
      <span class="bio-bar" aria-hidden="true"></span>
      <p class="lead">
        {
          toWords(texts.bio.lead).map(({ w, b, join }) => (
            <>
              <span class:list={['w', b && 'b']} style={`--i:${wi++}`}>{w}</span>{join ? '' : ' '}
            </>
          ))
        }
      </p>
      {
        texts.bio.paragraphs.map((p) => (
          <p>
            {toWords(p).map(({ w, b, join }) => (
              <>
                <span class:list={['w', b && 'b']} style={`--i:${wi++}`}>{w}</span>{join ? '' : ' '}
              </>
            ))}
          </p>
        ))
      }
      <p class="closing">
        {
          toWords(texts.bio.closing).map(({ w, b, join }) => (
            <>
              <span class:list={['w', b && 'b']} style={`--i:${wi++}`}>{w}</span>{join ? '' : ' '}
            </>
          ))
        }
      </p>
    </div>
    <p class="fx s1 hint a-l" style={`--x:${hint.label[0]};--y:${hint.label[1]}`}>{texts.hint}</p>
    <img
      class="fx s1 hint-arrow a-l"
      src={hintTop.src}
      alt=""
      style={`--x:${hint.top.pos[0]};--y:${hint.top.pos[1]};--w:${hint.top.w};--h:${hint.top.h}`}
    />
    <img
      class="fx s1 hint-arrow a-l"
      src={hintBottom.src}
      alt=""
      style={`--x:${hint.bottom.pos[0]};--y:${hint.bottom.pos[1]};--w:${hint.bottom.w};--h:${hint.bottom.h}`}
    />

    {/* ---------- État 2 : logiciels & outils ---------- */}
    <h2 class="fx s2 tools-title a-c" style="--x:742;--y:136;--w:430" aria-label={texts.toolsTitle}>
      {Array.from(texts.toolsTitle).map((c, i) => <span class="chr" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
    </h2>
    {
      tools.map((t, i) => (
        <button
          type="button"
          class="fx s2 tool a-c"
          style={`--x:${t.x};--y:${t.y};--w:123;--h:123;--i:${i}`}
          aria-label={t.name}
          aria-describedby={`tp-${i}`}
          data-tool={i}
        >
          <img
            class="abs"
            src={t.src}
            alt=""
            style={`--bx:${t.logo.x};--by:${t.logo.y};--bw:${t.logo.w};--bh:${t.logo.h}`}
            decoding="async"
          />
          <span class="tool-shine" aria-hidden="true"></span>
        </button>
      ))
    }
    {/* Panneau d'information : change quand on survole / sélectionne un logo */}
    <div
      class="fx s2 tools-panel a-c"
      data-tools-panel
      aria-live="polite"
      style={`--x:${toolsPanel.x};--y:${toolsPanel.y};--w:${toolsPanel.w}`}
    >
      <p class="tp tp-hint">{toolsPanel.hint}</p>
      {
        tools.map((t, i) => (
          <div class={`tp tp-card tp-${i}`} id={`tp-${i}`}>
            <div class="tp-head">
              <span class="tp-logo" aria-hidden="true">
                <img src={t.src} alt="" />
              </span>
              <h3>{t.name}</h3>
            </div>
            <p class="tp-desc">{t.desc}</p>
            <ul class="tp-tags">{t.tags.map((tag) => <li>{tag}</li>)}</ul>
          </div>
        ))
      }
    </div>

    {/* ---------- État 3 : appel à l'action ---------- */}
    <div class="fx s3 cta a-c" style="--x:470;--y:172;--w:620;--h:384">
      <h2 class="abs cta-title" style="--bx:34;--by:20">{texts.ctaTitle}</h2>
      <p class="abs cta-note" style="--bx:36;--by:82">{texts.ctaNote}</p>
      <p class="abs cta-chip" style="--bx:34;--by:150">
        <span class="cta-dot" aria-hidden="true"></span>{texts.ctaAvailability}
      </p>
      <a class="abs cta-btn" data-magnetic href={cvHref} download style="--bx:34;--by:206;--bw:250;--bh:66">
        <span>{texts.ctaCv}</span>
      </a>
      <a class="abs cta-btn cta-btn--ghost" data-magnetic href="/contact" style="--bx:300;--by:206;--bw:250;--bh:66">
        <span>{texts.ctaContact}</span>
      </a>
      <div class="abs cta-mail" style="--bx:34;--by:296">
        <a class="cta-mail-link" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          <span>{site.email}</span>
        </a>
        <button type="button" class="cta-copy" data-copy={site.email} data-copied={texts.ctaCopied}>
          <span>{texts.ctaCopy}</span>
        </button>
      </div>
    </div>

    {/* ---------- État 4 : pied de page ---------- */}
    <div class="fx s4 footer-bg" aria-hidden="true"></div>
    <nav class="fx s4 footer-nav" aria-label="Navigation">
      <button type="button" class="abs nav-link a-r" data-goto="1" style="--bx:696;--by:326">{nav[0].label}</button>
      <a class="abs nav-link a-r" href={nav[1].href} style="--bx:915;--by:326">{nav[1].label}</a>
      <a class="abs nav-link a-r" href={nav[2].href} style="--bx:1130;--by:329">{nav[2].label}</a>
    </nav>
    <p class="fx s4 copyright a-c" style="--x:527;--y:668;--w:219">© 2026 Enzo Loddo</p>

    {/* ---------- Éléments FIXES ---------- */}
    <button
      type="button"
      class="layer a-l camera"
      data-camera
      data-label="Clic : photo suivante"
      aria-label="Prendre la photo suivante"
      style={`--w:${camera.w};--h:${camera.h};${posVars(camera.pos)};--depth:0;--d:1.2s;--fx:${camera.flash.x}%;--fy:${camera.flash.y}%`}
    >
      <img src={camera.src} alt="" width={Math.round(camera.w)} height={Math.round(camera.h)} decoding="async" draggable="false" />
      <span class="cam-glow"></span>
    </button>

    <div class="arrows a-l" style={`--x:${arrows.x};--y:${arrows.y};--s:${num(arrows.size)}`}>
      <button type="button" class="arrow" data-step="-1" aria-label="Section précédente">
        <svg viewBox="0 0 60 60" fill="none" aria-hidden="true">
          <path
            d="M20 30L30 20L40 30M30 20V40M55 30C55 16.1929 43.8071 5 30 5C16.1929 5 5 16.1929 5 30C5 43.8071 16.1929 55 30 55C43.8071 55 55 43.8071 55 30Z"
            stroke="white"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="arrow" data-step="1" aria-label="Section suivante">
        <svg viewBox="0 0 60 60" fill="none" aria-hidden="true">
          <path
            d="M20 30L30 40L40 30M30 40V20M55 30C55 16.1929 43.8071 5 30 5C16.1929 5 5 16.1929 5 30C5 43.8071 16.1929 55 30 55C43.8071 55 55 43.8071 55 30Z"
            stroke="white"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

  </div>

  {/* ---------- Écran d'arrivée (rideau) ---------- */}
  <DiscoverHero />

  {/* Projecteur qui suit la souris + légende des éléments survolés */}
  <div class="spot" aria-hidden="true"></div>
  <div class="cursor-label" data-cursor-label aria-hidden="true"></div>

  {/* ---------- Ambiance : grain + vignette + flash ---------- */}
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="flash" data-flash aria-hidden="true"></div>

  {/* Logo ARRIVALS : toujours au premier plan, même sur l'écran d'arrivée */}
  <a
    class="group home-link header a-c"
    href="/"
    aria-label="ARRIVALS — retour à l’accueil"
    title="Retour à l’accueil"
    style={`--x:${header.x};--y:${header.y};--w:${header.w};--h:${header.h}`}
  >
    <ArrivalsLogo />
    <span class="home-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"></path></svg>
      Retour à l’accueil
    </span>
  </a>

  {/* Indicateur d'étapes */}
  <ol class="progress" aria-label="Étapes">
    {
      steps.map((label, i) => (
        <li>
          <button type="button" data-goto={i + 1} class={`pi pi-${i + 1}`} aria-label={`Aller à : ${label}`}>
            <span class="pi-num">0{i + 1}</span>
            <span class="pi-line"></span>
            <span class="pi-label">{label}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <p class="sr-only" aria-live="polite" data-live></p>
</section>

<style define:vars={{ sceneW: SCENE.width, sceneH: SCENE.height }}>
  .discover {
    /* 1 unité = 1 px de la maquette, adaptée à la hauteur / largeur de la fenêtre */
    --u: min(calc(100vw / var(--sceneW)), calc(100dvh / var(--sceneH)));
    position: relative;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--color-stage);
    color: var(--color-fg);
    touch-action: none;
  }

  .scene {
    position: relative;
    flex: none;
    width: 100%;
    height: calc(var(--sceneH) * var(--u));
    overflow: hidden;
  }

  /* Ancrages : gauche, centre, droite (les positions de la maquette sont relatives à ce repère) */
  .a-l { --ax: 0px; }
  .a-c { --ax: calc(50% - 640 * var(--u)); }
  .a-r { --ax: calc(100% - 1280 * var(--u)); }

  /* ---------- Calques animés : un déplacement par état ---------- */
  .layer {
    --x: var(--x1);
    --y: var(--y1);
    position: absolute;
    left: var(--ax);
    top: 0;
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    max-width: none;
    transform: translate3d(calc(var(--x) * var(--u)), calc(var(--y) * var(--u)), 0);
    /* Parallaxe souris : seuls les décors bougent (profondeur) ; le bloc Polaroïd reste fixe */
    translate: calc(var(--mx, 0) * var(--depth, 0) * -1px) calc(var(--my, 0) * var(--depth, 0) * -1px);
    transition:
      transform 1.5s ease-out,
      translate 0.7s ease-out,
      opacity 1.2s ease var(--d, 0s),
      scale 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0s);
    will-change: transform;
    pointer-events: none;
    user-select: none;
  }
  [data-state='2'] .layer { --x: var(--x2); --y: var(--y2); }
  [data-state='3'] .layer { --x: var(--x3); --y: var(--y3); }
  [data-state='4'] .layer { --x: var(--x4); --y: var(--y4); }

  /* Avant l'ouverture du rideau : la scène est « éteinte » puis s'assemble */
  [data-state='0'] .layer { opacity: 0; scale: 0.9; }

  /* Balancement permanent des plantes et photos (propriété rotate : indépendante du déplacement) */
  .decor[data-sway] {
    transform-origin: var(--sway-o, 50% 50%);
    animation: sway var(--sway-dur) ease-in-out var(--sway-delay) infinite;
  }
  @keyframes sway {
    0%, 100% { rotate: calc(var(--sway) * -1); }
    50%      { rotate: var(--sway); }
  }

  /* Position / taille à l'intérieur d'un groupe */
  .abs {
    position: absolute;
    left: calc(var(--bx, 0) * var(--u));
    top: calc(var(--by, 0) * var(--u));
    width: calc(var(--bw) * var(--u));
    height: calc(var(--bh) * var(--u));
    max-width: none;
  }
  button.abs, a.abs, p.abs, h2.abs { width: auto; height: auto; }
  .cta-btn.abs { width: calc(var(--bw) * var(--u)); height: calc(var(--bh) * var(--u)); }

  /* ---------- Photo qui « se développe » ---------- */
  .photo {
    filter: grayscale(1) brightness(0.45) contrast(1.1) sepia(0.4) blur(1.5px);
    transition: filter 2.2s ease;
  }
  [data-state='1'] .p1,
  [data-state='2'] .p2,
  [data-state='3'] .p3 {
    filter: none;
    transition-delay: 0.9s;
  }
  /* Les autres photos restent « ternes » tant qu'elles ne sont pas devant l'appareil */
  [data-state='4'] .p3 { filter: grayscale(0.6) brightness(0.8); }

  /* ---------- Appareil : lueur du flash ---------- */
  .camera img { width: 100%; height: 100%; display: block; }
  .cam-glow {
    position: absolute;
    left: var(--fx);
    top: var(--fy);
    width: 46%;
    aspect-ratio: 1;
    margin: -23% 0 0 -23%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 255 255 / 0.95) 0%, rgb(255 244 200 / 0.5) 35%, transparent 70%);
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
  }
  .camera.shoot .cam-glow { animation: cam-glow 0.9s ease-out; }
  @keyframes cam-glow {
    0%   { opacity: 0; transform: scale(0.4); }
    12%  { opacity: 1; transform: scale(1.1); }
    100% { opacity: 0; transform: scale(2); }
  }

  /* ---------- Textes : apparaissent / disparaissent selon l'état ---------- */
  .fx {
    position: absolute;
    left: calc(var(--ax, 0px) + var(--x, 0) * var(--u));
    top: calc(var(--y, 0) * var(--u));
    width: calc(var(--w, auto) * var(--u));
    height: calc(var(--h, auto) * var(--u));
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s ease, visibility 0s linear 0.45s;
  }
  [data-state='1'] .s1,
  [data-state='2'] .s2,
  [data-state='3'] .s3,
  [data-state='4'] .s4 {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.7s ease 0.7s, visibility 0s;
  }

  /* Lettres qui se composent */
  .chr {
    display: inline-block;
    white-space: pre;
    opacity: 0;
    transform: translateY(0.6em) rotate(5deg);
    transition: opacity 0.5s ease, transform 0.8s cubic-bezier(0.2, 0.9, 0.2, 1);
  }
  [data-state='1'] .s1 .chr,
  [data-state='2'] .s2 .chr {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.8s + var(--i) * 45ms);
  }

  .title {
    font: 700 max(calc(73 * var(--u)), 40px) / 1.2 var(--font-display);
    color: var(--color-accent);
    white-space: nowrap;
    width: auto;
    height: auto;
    text-shadow: 0 0 28px rgb(246 221 11 / 0.25);
  }

  /* Bio : mots qui apparaissent un à un, en jaune comme dans la maquette ; les mots clés ressortent en blanc */
  .bio {
    font: 400 max(calc(18 * var(--u)), 16px) / 1.65 var(--font-sans);
    color: var(--color-accent);
    text-align: left;
    opacity: 1;
    transition: visibility 0s linear 0.6s;
  }
  [data-state='1'] .bio { transition: visibility 0s; }
  .bio p { margin: 0; }
  .bio p + p { margin-top: calc(20 * var(--u)); }
  /* Petit trait d'accent au-dessus de l'accroche */
  .bio-bar {
    display: block;
    width: calc(64 * var(--u));
    height: 3px;
    margin-bottom: calc(16 * var(--u));
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 0 0 12px rgb(246 221 11 / 0.7);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  [data-state='1'] .bio-bar { transform: scaleX(1); transition: transform 0.9s cubic-bezier(0.2, 0.9, 0.2, 1) 0.8s; }
  /* Accroche : plus grande */
  .bio .lead {
    font: 500 max(calc(26 * var(--u)), 19px) / 1.35 var(--font-display);
    letter-spacing: 0.01em;
    margin-bottom: calc(22 * var(--u));
  }
  .bio .w.b { color: #fff; font-weight: 600; }
  /* Conclusion */
  .bio .closing {
    margin-top: calc(22 * var(--u));
    padding-left: calc(16 * var(--u));
    border-left: 3px solid var(--color-accent);
    color: #fff;
    font-weight: 500;
  }
  .bio p + .closing { margin-top: calc(22 * var(--u)); }
  .bio .w {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.5em);
    filter: blur(4px);
    transition: opacity 0.5s ease, transform 0.7s ease, filter 0.6s ease;
  }
  [data-state='1'] .bio .w {
    opacity: 1;
    transform: none;
    filter: none;
    transition-delay: calc(0.9s + var(--i) * 16ms);
  }

  .hint {
    font: 400 max(calc(20 * var(--u)), 16px) / 1.4 var(--font-display);
    color: #fff;
    width: auto;
    height: auto;
    white-space: nowrap;
  }
  .hint-arrow { max-width: none; }

  .tools-title {
    font: 400 max(calc(55 * var(--u)), 28px) / 1.1 var(--font-display);
    color: var(--color-accent);
    white-space: nowrap;
    height: auto;
    text-shadow: 0 0 24px rgb(246 221 11 / 0.22);
  }
  /* Tuiles : rebondissent l'une après l'autre */
  .tool {
    background: var(--color-accent);
    border-radius: calc(23 * var(--u));
    scale: 0.4;
    rotate: -12deg;
    transition: opacity 0.4s ease, scale 0.4s ease, rotate 0.4s ease, visibility 0s linear 0.45s, transform 0.35s ease, box-shadow 0.35s ease;
  }
  [data-state='2'] .tool {
    scale: 1;
    rotate: 0deg;
    transition:
      opacity 0.5s ease calc(1s + var(--i) * 0.09s),
