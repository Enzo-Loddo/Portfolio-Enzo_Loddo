<script>
  import { STATE_COUNT } from '@/data/discover';

  const root = document.querySelector<HTMLElement>('[data-discover]');
  if (root) {
    const prev = root.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-step="1"]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const camera = root.querySelector<HTMLElement>('.camera')!;
    const flash = root.querySelector<HTMLElement>('[data-flash]')!;
    const labels = ['Introduction', 'Présentation', 'Logiciels et outils', 'Me contacter', 'Fin de la page'];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 1600; // 1,5 s d'animation + marge
    let state = 0;
    let locked = false;

    /** Rejoue une animation CSS portée par une classe. */
    const replay = (el: HTMLElement, cls: string) => {
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
    };

    const render = (silent = false) => {
      root.dataset.state = String(state);
      if (state >= 1 && !silent) root.dataset.used = '';
      // La vidéo ne tourne que sur l'écran d'arrivée (économie de ressources)
      if (!reduce && !silent) {
        if (state === 0) window.dispatchEvent(new Event('hero:play'));
        else window.setTimeout(() => state !== 0 && window.dispatchEvent(new Event('hero:pause')), 1700);
      }
      prev.setAttribute('aria-disabled', String(state <= 0));
      next.setAttribute('aria-disabled', String(state === STATE_COUNT));
      live.textContent = `${labels[state]}${state ? ` (${state} sur ${STATE_COUNT})` : ''}`;
      if (!silent && !reduce) {
        // Flash d'appareil photo + avion à chaque changement de section
        if (state >= 1) {
          replay(camera, 'shoot');
          replay(flash, 'go');
        }
      }
    };

    const go = (to: number) => {
      const target = Math.min(Math.max(to, 0), STATE_COUNT);
      if (target === state || locked) return;
      state = target;
      locked = true;
      render();
      window.setTimeout(() => (locked = false), DURATION);
    };

    prev.addEventListener('click', () => go(state - 1));
    next.addEventListener('click', () => go(state + 1));
    root.querySelectorAll<HTMLElement>('[data-goto]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        go(Number(el.dataset.goto));
      }),
    );
    // Clic n'importe où sur l'écran d'arrivée : on embarque
    root.querySelector('[data-hero]')?.addEventListener('click', () => go(1));

    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && state === 0)) { e.preventDefault(); go(state + 1); }
      if (e.key === 'ArrowUp' || e.key === 'PageUp') { e.preventDefault(); go(state - 1); }
    });

    // Molette et balayage tactile : même effet que les flèches
    window.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) < 20) return;
      go(state + (e.deltaY > 0 ? 1 : -1));
    }, { passive: true });

    let touchY = 0;
    window.addEventListener('touchstart', (e) => { touchY = e.touches[0].clientY; }, { passive: true });
    window.addEventListener('touchend', (e) => {
      const dy = touchY - e.changedTouches[0].clientY;
      if (Math.abs(dy) > 50) go(state + (dy > 0 ? 1 : -1));
    }, { passive: true });

    // Parallaxe : les décors suivent doucement la souris, les éléments fixes ne bougent pas
    if (!reduce) {
      let raf = 0;
      window.addEventListener('pointermove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          root.style.setProperty('--mx', String(((e.clientX / window.innerWidth) * 2 - 1).toFixed(3)));
          root.style.setProperty('--my', String(((e.clientY / window.innerHeight) * 2 - 1).toFixed(3)));
          root.style.setProperty('--px', `${e.clientX}px`);
          root.style.setProperty('--py', `${e.clientY}px`);
        });
      });

      // Boutons « magnétiques » : ils se rapprochent légèrement du curseur
      root.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
        btn.addEventListener('pointermove', (e) => {
          const r = btn.getBoundingClientRect();
          const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
          const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
          btn.style.transform = `translate(${dx * 10}px, ${dy * 8 - 3}px)`;
        });
        btn.addEventListener('pointerleave', () => (btn.style.transform = ''));
      });
    }

    // Écran d'arrivée : pas de lecture automatique si l'utilisateur préfère moins d'animations
    // Le lien de crédit ne doit pas déclencher l'embarquement
    root.querySelector('.hero-credit a')?.addEventListener('click', (e) => e.stopPropagation());

    // Appareil Polaroïd : un clic = photo suivante
    root.querySelector('[data-camera]')?.addEventListener('click', () => go(state >= STATE_COUNT ? 1 : state + 1));

    // Panneau d'information des outils + inclinaison des tuiles
    const panel = root.querySelector<HTMLElement>('[data-tools-panel]');
    let panelTimer = 0;
    root.querySelectorAll<HTMLElement>('.tool').forEach((tile) => {
      const show = () => {
        window.clearTimeout(panelTimer);
        panel?.setAttribute('data-tool', tile.dataset.tool ?? '');
      };
      const hide = () => {
        window.clearTimeout(panelTimer);
        panelTimer = window.setTimeout(() => panel?.removeAttribute('data-tool'), 220);
      };
      tile.addEventListener('pointerenter', show);
      tile.addEventListener('focus', show);
      tile.addEventListener('click', show);
      tile.addEventListener('pointerleave', () => {
        tile.style.removeProperty('--rx');
        tile.style.removeProperty('--ry');
        hide();
      });
      tile.addEventListener('blur', hide);
      tile.addEventListener('pointermove', (e) => {
        if (reduce) return;
        const r = tile.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        tile.style.setProperty('--rx', `${((px - 0.5) * 22).toFixed(1)}deg`);
        tile.style.setProperty('--ry', `${((0.5 - py) * 22).toFixed(1)}deg`);
        tile.style.setProperty('--gx', `${(px * 100).toFixed(0)}%`);
        tile.style.setProperty('--gy', `${(py * 100).toFixed(0)}%`);
      });
    });

    // Bouton « Copier » de l'e-mail
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.querySelector('span')!;
      const original = label.textContent ?? '';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          label.textContent = btn.dataset.copied ?? 'OK';
          btn.classList.add('done');
          window.setTimeout(() => {
            label.textContent = original;
            btn.classList.remove('done');
          }, 1800);
        } catch {
          window.location.href = `mailto:${btn.dataset.copy}`;
        }
      });
    });

    // Carte d'appel à l'action : le reflet suit le curseur
    root.querySelector<HTMLElement>('.cta')?.addEventListener('pointermove', (e) => {
      const el = e.currentTarget as HTMLElement;
      const r = el.getBoundingClientRect();
      el.style.setProperty('--gx', `${(((e.clientX - r.left) / r.width) * 100).toFixed(0)}%`);
      el.style.setProperty('--gy', `${(((e.clientY - r.top) / r.height) * 100).toFixed(0)}%`);
    });

    // Légende au survol des décors et de l'appareil
    const tip = root.querySelector<HTMLElement>('[data-cursor-label]')!;
    root.addEventListener('pointermove', (e) => {
      const target = (e.target as Element | null)?.closest<HTMLElement>('[data-label]');
      if (target && state >= 1) {
        tip.textContent = target.dataset.label ?? '';
        tip.style.setProperty('--lx', `${e.clientX + 16}px`);
        tip.style.setProperty('--ly', `${e.clientY + 20}px`);
        tip.classList.add('on');
      } else {
        tip.classList.remove('on');
      }
    });
    root.addEventListener('pointerleave', () => tip.classList.remove('on'));

    render(true);
  }
</script>
