---
/**
 * Vidéo de fond du héros (fichier local, lecture automatique, muette, en boucle, sans interface).
 *
 * Contrôle : les événements `hero:play` / `hero:pause` (window) lancent ou mettent en pause la lecture.
 * Si l'utilisateur préfère réduire les animations, seule l'image d'attente est affichée.
 */
import { hero } from '@/data/discover';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['hv', className]} data-hv>
  <video
    class="hv-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={hero.video.poster}
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={hero.video.webm} type="video/webm" />
    <source src={hero.video.mp4} type="video/mp4" />
  </video>
</div>

<style>
  .hv {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0b0b0b;
    pointer-events: none;
  }
  .hv-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-hv] .hv-video');

  videos.forEach((video) => {
    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
      return;
    }
    window.addEventListener('hero:play', () => void video.play().catch(() => {}));
    window.addEventListener('hero:pause', () => video.pause());
  });
</script>
