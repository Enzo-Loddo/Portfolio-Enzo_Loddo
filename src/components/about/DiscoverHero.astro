---
/**
 * Écran d'arrivée de « Me découvrir » : une vidéo de présentation de La Réunion en boucle, un billet d'embarquement
 * et un titre qui se compose lettre par lettre. Au clic / défilement, l'écran se lève comme un rideau
 * et révèle la page derrière (voir DiscoverStage).
 */
import { hero } from '@/data/discover';
import HeroVideo from './HeroVideo.astro';

let k = 0;
---

<section class="hero" data-hero aria-label="Introduction">
  <HeroVideo class="hero-bg" />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-sun" aria-hidden="true"></div>

  <div class="hero-copy">
    <ul class="ticket" aria-label="Billet d’embarquement">
      {hero.ticket.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}
    </ul>

    <h1 class="hero-title" aria-label={`${hero.lines.join(' ')} — Me découvrir`}>
      {
        hero.lines.map((line) => (
          <span class="hero-line" aria-hidden="true">
            {Array.from(line).map((ch) => (
              <span class="ch" style={`--i:${k++}`}>{ch}</span>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="hero-sub">{hero.subtitle} <span aria-hidden="true">—</span> <strong>Me découvrir</strong></p>

    <button type="button" class="hero-cta" data-goto="1">
      <span>{hero.cta}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 4v15M5 13l7 7 7-7"></path>
      </svg>
    </button>
    <p class="hero-cue" aria-hidden="true">{hero.cue}</p>
  </div>

  <p class="hero-credit">
    <a href={hero.credit.href} target="_blank" rel="noopener noreferrer" data-no-transition>{hero.credit.text}</a>
  </p>
</section>

<style>
  .hero {
    position: absolute;
    inset: 0;
    z-index: 30;
    overflow: hidden;
    background: #0b0b0b;
    color: #fff;
    cursor: pointer;
    /* Se lève comme un rideau quand on quitte l'état 0 */
    transition: transform 1.5s cubic-bezier(0.77, 0, 0.18, 1);
  }
  :global([data-state]:not([data-state='0'])) .hero {
    transform: translateY(-101%);
    pointer-events: none;
  }

  .hero-bg {
    inset: -4%;
    width: 108%;
    height: 108%;
    transform: translate3d(calc(var(--mx, 0) * -14px), calc(var(--my, 0) * -10px), 0) scale(1.04);
    animation: ken-burns 26s ease-in-out infinite alternate;
    transition: translate 1.5s cubic-bezier(0.77, 0, 0.18, 1);
  }
  :global([data-state]:not([data-state='0'])) .hero-bg {
    translate: 0 14%;
  }
  @keyframes ken-burns {
    from { scale: 1; }
    to   { scale: 1.12; }
  }

  /* Dégradés : assombrit le bas pour la lisibilité et fond la photo dans la couleur de la page */
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, #191b1c 0%, rgb(25 27 28 / 0.8) 14%, rgb(0 0 0 / 0.18) 50%, rgb(0 0 0 / 0.08) 100%),
      radial-gradient(ellipse 90% 80% at 50% 45%, transparent 50%, rgb(0 0 0 / 0.4) 100%);
  }
  /* Reflet du soleil : lueur chaude qui respire */
  .hero-sun {
    position: absolute;
    left: 15%;
    top: 12%;
    width: 36vmin;
    height: 36vmin;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 244 200 / 0.55) 0%, rgb(255 214 120 / 0.18) 40%, transparent 70%);
    mix-blend-mode: screen;
    animation: sun-breathe 7s ease-in-out infinite;
  }
  @keyframes sun-breathe {
    0%, 100% { opacity: 0.55; transform: scale(0.95); }
    50%      { opacity: 1; transform: scale(1.15); }
  }

  .hero-copy {
    position: absolute;
    left: max(5vw, 24px);
    right: max(5vw, 24px);
    bottom: max(9vh, 72px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(10px, 1.6vh, 20px);
  }

  /* Billet d'embarquement */
  .ticket {
    display: flex;
    gap: 0;
    margin: 0 0 clamp(4px, 1vh, 12px);
    padding: 0;
    list-style: none;
    font: 500 clamp(13px, 1.1vw, 17px) / 1 var(--font-display);
    letter-spacing: 0.22em;
    color: #000;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.45));
  }
  .ticket li {
    padding: 0.8em 1.3em;
    background: var(--color-accent);
    opacity: 0;
    animation: pop-in 0.7s cubic-bezier(0.2, 0.9, 0.2, 1) forwards;
    animation-delay: calc(0.5s + var(--i) * 0.12s);
  }
  .ticket li + li { border-left: 2px dashed rgb(0 0 0 / 0.45); }
  .ticket li:first-child { border-radius: 8px 0 0 8px; }
  .ticket li:last-child { border-radius: 0 8px 8px 0; }

  .hero-title {
    margin: 0;
    font: 700 clamp(4.2rem, 15vw, 14rem) / 0.9 var(--font-display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-shadow: 0 6px 40px rgb(0 0 0 / 0.55);
  }
  .hero-line { display: block; }
  .hero-line:last-child { color: var(--color-accent); text-shadow: 0 0 36px rgb(246 221 11 / 0.4), 0 6px 40px rgb(0 0 0 / 0.5); }
  .ch {
    display: inline-block;
    opacity: 0;
    transform: translateY(45%) rotate(6deg);
    animation: ch-rise 1s cubic-bezier(0.2, 0.9, 0.2, 1) forwards;
    animation-delay: calc(0.8s + var(--i) * 0.07s);
  }

  .hero-sub {
    margin: 0;
    font: 400 clamp(1rem, 1.9vw, 1.9rem) / 1.3 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0;
    animation: fade-up 0.9s ease forwards 1.9s;
  }
  .hero-sub strong { color: var(--color-accent); font-weight: 500; }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    margin-top: clamp(6px, 1.5vh, 18px);
    padding: 0.85em 1.8em;
    border: 2px solid var(--color-accent);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.35);
    color: var(--color-accent);
    font: 500 clamp(1rem, 1.4vw, 1.35rem) / 1 var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
    cursor: pointer;
    opacity: 0;
    animation: fade-up 0.9s ease forwards 2.2s;
    transition: background 0.3s, color 0.3s, transform 0.3s;
  }
  .hero-cta svg { width: 1.2em; height: 1.2em; animation: bounce 1.6s ease-in-out infinite; }
  .hero-cta:hover,
  .hero-cta:focus-visible { background: var(--color-accent); color: #000; transform: translateY(-3px); }

  .hero-cue {
    margin: 0;
    font: 400 0.95rem / 1 var(--font-sans);
    color: rgb(255 255 255 / 0.8);
    opacity: 0;
    animation: fade-up 0.9s ease forwards 2.5s;
  }

  .hero-credit {
    position: absolute;
    right: max(2vw, 14px);
    bottom: 12px;
    margin: 0;
    font: 400 0.8rem / 1 var(--font-sans);
    color: rgb(255 255 255 / 0.7);
  }
  .hero-credit a { color: inherit; text-underline-offset: 3px; }
  .hero-credit a:hover { color: var(--color-accent); text-decoration: underline; }

  @keyframes ch-rise { to { opacity: 1; transform: translateY(0) rotate(0); } }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pop-in {
    from { opacity: 0; transform: translateY(-14px) scale(0.9); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(-2px); }
    50%      { transform: translateY(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg, .hero-sun, .hero-cta svg { animation: none; }
    .ch, .ticket li, .hero-sub, .hero-cta, .hero-cue { animation-duration: 0.01s; animation-delay: 0s; }
    .hero { transition-duration: 0.01s; }
  }
</style>
