---
interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-sm bg-accent px-8 py-3.5 font-display text-nav uppercase text-ink transition-transform hover:-translate-y-0.5',
    className,
  ]}
>
  <slot />
</a>
